{
  "name": "pickflow",
  "version": "0.1.0",
  "private": true,
  "description": "Pickflow — preparación y despacho de pedidos para depósitos (web + Android)",
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "dev:mobile": "npm run start --prefix apps/mobile",
    "build:web": "npm run build --prefix apps/web",
    "lint:web": "npm run lint --prefix apps/web",
    "lint:mobile": "npm run lint --prefix apps/mobile",
    "lint": "npm run lint:web && npm run lint:mobile",
    "test:web": "npm test --prefix apps/web",
    "icons:placeholder": "node scripts/gen-placeholder-icons.mjs",
    "icons:instance": "node scripts/gen-placeholder-icons.mjs",
    "sounds:generate": "node scripts/gen-beeps.mjs",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "db:local": "supabase start && supabase db reset",
    "db:test": "supabase test db && bash scripts/db-concurrency-test.sh",
    "db:types": "supabase gen types typescript --local > apps/web/types/supabase.ts && cp apps/web/types/supabase.ts apps/mobile/types/supabase.ts",
    "db:setup": "bash scripts/db-setup.sh",
    "db:create-admin": "node scripts/db-create-admin.mjs",
    "db:bundle": "node scripts/db-bundle.mjs"
  },
  "keywords": [
    "wms",
    "picking",
    "inventory",
    "warehouse",
    "saas"
  ],
  "author": "",
  "license": "UNLICENSED"
}
